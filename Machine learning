import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score
from sklearn.metrics import confusion_matrix
from sklearn.metrics import classification_report
import os

arquivo = r"C:\Users\User\Desktop\machine_learning_previsao\dados\dados_gerados.csv"

dados = pd.read_csv(arquivo, encoding="utf-16", sep='\t')
dados['proximo_close'] = dados['ch2'].shift(-1)
dados['alvo'] = (dados['proximo_close'] > dados['ch2']).astype(int)

x = dados [['oh2', 'hh2', 'ch2', 'lh2', 
            'od1', 'hd1', 'cd1', 'ld1', 
            'oh4', 'hh4', 'ch4', 'lh4', 
            'oh6', 'hh6', 'ch6', 'lh6',
            'oh8', 'hh8', 'ch8', 'lh8',
            'oh12', 'hh12', 'ch12', 'lh12'
            ]]

y = dados ['alvo']

tamanho = int(len(dados) * 0.8)

x_treino =x.iloc[:tamanho]
x_teste = x.iloc[tamanho:]

y_treino = y.iloc[:tamanho]
y_teste = y.iloc[tamanho:]

modelo = RandomForestClassifier(n_estimators=100, 
                                random_state=100)
modelo.fit(x_treino, y_treino)

previsoes = modelo.predict(x_teste)

acuracia = accuracy_score(y_teste, previsoes)

print("Acurácia:", acuracia)

previsao = modelo.predict(x.iloc[[-1]])

if previsao[0] == 1:
    print("Previsão: COMPRA / ALTA")
else:
    print("Previsão: VENDA / BAIXA")

previsao = modelo.predict(x.iloc[[-1]])[0]
probabilidade = modelo.predict_proba(x.iloc[[-1]])[0]

resultado = previsoes == y_teste.to_numpy()
print('Quantidade de Acertos: ',resultado.sum())
print('Quantidade de Erros: ',(~resultado).sum())
print(confusion_matrix(y_teste, previsoes))
print(classification_report(y_teste, previsoes))

quantidade_previsoes = 8905
ultimas_previsoes = previsoes[-quantidade_previsoes:]
ultimos_reais = y_teste.to_numpy()[-quantidade_previsoes:]

lista = pd.DataFrame({
    'Indice': range(1, len(ultimas_previsoes) + 1),
    'Previsao': [
        "COMPRA / ALTA" if x == 1 else "VENDA / BAIXA"
        for x in ultimas_previsoes
    ],
    'Real': [
        "COMPRA / ALTA" if x == 1 else "VENDA / BAIXA"
        for x in ultimos_reais
    ]
})

lista['Resultado'] = [
    "ACERTO" if previsao == real else "ERRO"
    for previsao, real in zip(ultimas_previsoes, ultimos_reais)
]

caminho = os.path.abspath('lista_previsoes.csv')

lista.to_csv(caminho, index=False, encoding='utf-8-sig')

print("Lista completa salva em:")
print(caminho)
print(modelo.feature_importances_)
