datetime ultimo_candle = 0; 
 
void OnTick() 
{ 
   datetime candle_atual = iTime(_Symbol, PERIOD_H2, 0); 
 
   if(candle_atual != ultimo_candle) 
   { 
      ultimo_candle = candle_atual; 
 
      Print("Novo candle detectado!"); 
 
      AtualizarDados(); 
   } 
} 
 
